{
  "XDbApiConfig": {
    "DbScripts": [
        {
            "ScriptKey": "InsertScript",
            "ScriptCode": "CALL sys.insert_action( @tname, @rows::jsonb )"
        },
        {
            "ScriptKey": "InsertScriptDupIgnore",
            "ScriptCode": "CALL sys.insert_action_ignore( @tname, @rows::jsonb )"
        },
        {
            "ScriptKey": "SelectById",
            "ScriptCode": "select * from sys.get_from_table_json( @p_table_name, @p_id::timestamp )"
        },
        {
            "ScriptKey": "SelectByIds",
            "ScriptCode": "select * from sys.get_from_table_jsonb( @p_table_name, @p_ids::jsonb, @p_select_fields )"
        },
        {
            "ScriptKey": "SelectByGroup",
            "ScriptCode": "select * from sys.group_rows_to_json( @p_table_name, @p_ids::jsonb, @p_select_fields )"
        },
        {
            "ScriptKey": "UpdateScript",
            "ScriptCode": "CALL sys.update_action( @tname, @rows::jsonb, null )"
        },
        {
            "ScriptKey": "DeleteScript",
            "ScriptCode": "CALL sys.delete_action( @tname, @rows::jsonb )"
        }
    ] 
  }
}
